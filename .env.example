# --- ALM Access Request retrieval (OSLC REST API) ---
# EWM/ccm base. Switch TEST/PROD by changing this one line.
#   TEST: https://ewm-test.example.intra/ccm
#   PROD: https://ewm.example.intra/ccm
EWM_SERVER=
# Your Jazz/EWM username. Both agents use CID; EWM_USER remains a CLI-compatible alias.
CID=
# EWM_PASSWORD=   # optional; prefer the interactive prompt
# Use these to skip additional discovery and limit the agent to the required OSLC
# endpoints only.
EWM_PROJECT_UUID=
EWM_WORKFLOW_STATE_ID=
EWM_ACTIVE_STATE_IDS=

# --- GPT (Global Provisioning Tool) provisioning ---
GPT_URL=
GROUP_NAME=
AD_LABEL=
DOMAIN=
# Comma-separated user IDs to add. Leave empty and use --auto to pull from the open ELM tab.
USER_IDS=
# CDP endpoint of the debug Chrome started by start-gpt.ps1
CDP_URL=http://127.0.0.1:9222
# false = dry run (stage only). Use --commit to submit.
COMMIT=false

# --- JTS user import (Jazz Team Server user registry) ---
JTS_SERVER=
# File written by the retrieval agent and read by the import agent.
ALM_USERS_OUT=out/alm_users.json

# --- Network ---
# requests/urllib do not evaluate the corporate PAC file, so intranet hosts would
# otherwise be tunnelled through the proxy and fail with 502 Bad Gateway.
NO_PROXY=.example.intra,localhost,127.0.0.1
# Internet access for Gemini (the agents only: the CLI never leaves the intranet).
# Behind a corporate proxy, name it here; the intranet hosts above bypass it.
# HTTPS_PROXY=http://proxy.example.com:8080
# If the proxy inspects HTTPS, --check reports an untrusted certificate. Point
# both at the company root CA bundle (.pem): REQUESTS_CA_BUNDLE is read by
# --check, SSL_CERT_FILE by the Gemini client. EWM/JTS keep ALM_CA_BUNDLE.
# REQUESTS_CA_BUNDLE=
# SSL_CERT_FILE=

# --- Safety and environment ---
# Which environment these servers belong to. Leave blank to derive it from the
# host names (a "tst" host is TEST, otherwise PROD). Every entry point prints a
# banner with this value, and a PROD write must be confirmed by typing PROD.
ALM_ENV=
# Set to PROD to pre-authorise production writes for a non-interactive run.
# Leave unset for normal interactive use so the confirmation is actually asked.
# ALM_PROD_CONFIRM=

# --- TLS ---
# Path to the corporate CA bundle (.pem). When set, every request verifies the
# server certificate. Strongly recommended: without it credentials are POSTed
# over a connection that cannot detect interception.
ALM_CA_BUNDLE=
# Alternative to ALM_CA_BUNDLE when the corporate CA is already in the system
# trust store: true = verify, strict = refuse to run unverified, unset = do not
# verify (prints a warning on every run).
ALM_TLS_VERIFY=

# --- Work-item comment ---
# First line of the comment posted to each work item. The per-user lines are
# generated from what the import step actually did and are not configurable.
# ALM_COMMENT_HEADER=ALM access provisioning result :

# =============================================================================
# Multi-agent system, run locally: python src/agent_local.py
# Uses the CLI settings above unchanged (EWM_SERVER, JTS_SERVER, CID, the
# project/state ids, ALM_CA_BUNDLE / ALM_TLS_VERIFY, CDP_URL, GPT_URL, AD_LABEL,
# GROUP_NAME, DOMAIN). The password is prompted, as in the CLI. Add:
# =============================================================================
# Ledger, audit trail, approvals and resumable checkpoints, in one local file.
# Default out/local/alm.db. The CLI's out/audit/ is separate: do not run the CLI
# and the agents on the same work items.
ALM_LEDGER_PATH=
# Strip e-mail addresses and personal names from what Gemini reads (user IDs
# are kept). On the Gemini API free tier Google may use prompts to improve its
# products - use a paid key for real work items.
ALM_REDACT_FOR_MODEL=true
# Evidence screenshots of each user's JTS profile. Default: the installed
# Microsoft Edge on Windows (as the CLI), bundled Chromium elsewhere.
# ALM_BROWSER_CHANNEL=msedge
# true shows the browser while it captures - useful when a screenshot fails.
# ALM_BROWSER_HEADED=false

# --- AI models (Gemini) ---
# Where the model comes from:
#   gemini_api : the Gemini Developer API, with the key below. Quickest start;
#                what agent_local.py and the sandbox use by default.
#   vertex_express : Vertex AI with an API key made in the Google Cloud console
#                (Vertex AI > API keys). Looks like an AI Studio key but only
#                works here - `--check` tells you which kind you have.
#   vertex     : the same models on Vertex AI, authenticated as the service
#                account - no key at all. Needs GOOGLE_CLOUD_PROJECT; also serves
#                claude-* models from Model Garden.
#   bedrock    : AWS Bedrock with the runtime IAM role (ALM_AWS_REGION); the
#                model id goes in ALM_AGENT_MODEL, e.g. anthropic.claude-...
#   azure_openai: Azure OpenAI; ALM_AGENT_MODEL is the deployment name. Managed
#                identity, or AZURE_OPENAI_API_KEY.
ALM_LLM_PROVIDER=gemini_api
ALM_AZURE_OPENAI_ENDPOINT=
# Your key from https://aistudio.google.com/apikey - paste it after the = sign.
# This file is .env.example (committed); put the real value in .env (gitignored).
# Never paste the key into code, a commit, or a chat.
GEMINI_API_KEY=
# Agents reason and call tools with ALM_AGENT_MODEL; the supervisor only routes,
# so a lighter model is enough. `python src/agent_local.py --check` says whether
# your key can use them.
ALM_AGENT_MODEL=gemini-3.5-flash
ALM_SUPERVISOR_MODEL=gemini-3.1-flash-lite
# Shared by every agent in the process. The free tier allows only a handful of
# requests per minute; a multi-agent run makes dozens.
ALM_LLM_REQUESTS_PER_MINUTE=10
# default | minimal | low | medium | high. Routing and tool calls need little.
ALM_LLM_THINKING_LEVEL=low
ALM_LLM_ENABLED=true

# --- Orchestration ---
# guided   : the nine agents run in a fixed order; the supervisor model is asked
#            only when something goes wrong. The default for local runs.
# agentic  : a model supervisor chooses every step. More model calls.
# deterministic : the fixed graph, same tools and guarantees, no routing model.
#                 Also the kill switch during an incident.
ALM_ORCHESTRATION=guided
ALM_MAX_HOPS=24
ALM_MAX_WRITES_PER_RUN=50
ALM_MAX_TOOL_CALLS_PER_RUN=400

# --- AI governance ---
# Model tokens (input + output) one run may spend; the run stops at the cap. 0 = none.
ALM_MAX_TOKENS_PER_RUN=400000
# Model tokens all runs started in one UTC day may spend; 0 = none. Past it a
# new run is refused - or, with the setting below, runs in the fixed order.
ALM_MAX_TOKENS_PER_DAY=0
# When the model is unavailable (or the daily cap is spent), re-run the same
# work items in the fixed order, which needs no model. Writing runs still stop
# at the approval card.
ALM_DEGRADE_ON_MODEL_FAILURE=false
# Model providers this deployment may use (comma-separated); empty = any.
# A client data policy goes here, e.g. vertex or bedrock.
ALM_ALLOWED_PROVIDERS=
# Tool-result fields never shown to a model (comma-separated), e.g.
# justification,summary. The tools still use them.
ALM_MODEL_WITHHELD_FIELDS=

# --- User-ID recovery (optional: TypeSafe) ---
# When a New Users row cannot be parsed, code lists every token shaped like a
# user ID and a model judges which are people being requested. The answer is
# always a token copied from the row, never a generated one.
#   auto     : TypeSafe when the key below is set, Gemini otherwise
#   typesafe : TypeSafe only; if it fails, the row goes to a human
#   gemini   : the agent model judges (still limited to the listed tokens)
ALM_EXTRACTION_PROVIDER=auto
# From https://console.typesafe.ai/ - real value in .env only, never committed.
# Not reachable from Cloud Run as deployed: that network has no internet egress.
TYPESAFE_API_KEY=
ALM_TYPESAFE_MODEL=jev-latest
# Candidates below this probability are not proposed. A placeholder: tune it on
# real malformed rows. Recovered users always go to a human approver anyway.
ALM_EXTRACTION_MIN_PROBABILITY=0.5

# =============================================================================
# Cloud deployment only (GCP, AWS or Azure) - optional, not needed locally.
# The platform injects most of it. A local run reads only GOOGLE_CLOUD_PROJECT,
# ALM_REGION and ALM_VERTEX_LOCATION, and only with ALM_LLM_PROVIDER=vertex.
# =============================================================================

# --- Project and region ---
GOOGLE_CLOUD_PROJECT=
ALM_REGION=europe-west1
# Vertex AI region if it must differ from ALM_REGION (vertex provider only).
ALM_VERTEX_LOCATION=

# --- Shadow mode ---
# Read and plan, write nothing. Turning this off is the decision that lets an
# agent write; it belongs in a change record.
ALM_SHADOW_MODE=true

# --- Database (Postgres on any cloud) ---
# Private address. With IAM database authentication the password is omitted - a
# short-lived token is minted from the runtime identity at connect time.
ALM_POSTGRES_DSN=
# password | gcp_iam (Cloud SQL) | aws_iam (RDS) | azure_ad (Azure Database for
# PostgreSQL). auto: gcp_iam when ALM_POSTGRES_IAM_AUTH=true, else password.
ALM_DB_AUTH=auto
ALM_POSTGRES_IAM_AUTH=true

# --- Workers ---
# Runs this process drives at once (0: the API only queues; run
# `python -m alm_agents.worker` separately). Leases, retries, the sweep:
ALM_WORKER_CONCURRENCY=1
ALM_JOB_LEASE_SECONDS=120
ALM_JOB_MAX_ATTEMPTS=5
# Minutes between queue sweeps; 0 turns the sweep off.
ALM_RECONCILE_INTERVAL_MINUTES=15
# Once a day, delete finished runs' data older than this many days: checkpoints,
# traces, approval cards, votes, agent memory. Never the ledger or the audit
# trail. 0 keeps everything. (Laptop runs: agent_local.py --purge-older-than.)
ALM_RETENTION_DAYS=30
# A standalone worker answers GET /healthz here, for liveness probes; 0 = none.
# The worker image sets 8080.
ALM_WORKER_HEALTH_PORT=0

# --- AD group membership ---
# gpt: the GPT web UI (Windows worker, or the debug Chrome locally).
# graph: Microsoft Graph from the run itself - only for groups mastered in Entra
# ID; a group synced from on-premises AD must stay on gpt.
ALM_AD_DIRECTORY=gpt
ALM_GRAPH_TENANT_ID=
ALM_GRAPH_CLIENT_ID=
# The client secret is a secret: environment, mounted file or the cloud store,
# under this name.
ALM_GRAPH_CLIENT_SECRET_NAME=alm-graph-client-secret
# Object id of the group (looked up by name when empty).
ALM_GRAPH_GROUP_ID=
# sam: onPremisesSamAccountName (synced accounts) | upn: <userid>@<suffix>
ALM_GRAPH_USER_LOOKUP=sam
ALM_GRAPH_UPN_SUFFIX=

# --- AD jobs for the Windows worker ---
# store: the shared Postgres job queue (any cloud). pubsub: Google Pub/Sub.
ALM_AD_JOB_TRANSPORT=store
ALM_PUBSUB_TOPIC=alm-ad-provisioning
ALM_PUBSUB_SUBSCRIPTION=alm-ad-provisioning-worker

# --- Secrets (after the environment and mounted files) ---
# auto (Secret Manager when GOOGLE_CLOUD_PROJECT is set) | gcp | aws | azure | none
ALM_SECRET_BACKEND=auto
# AWS Secrets Manager: secret id = prefix + name, e.g. alm/prod/alm-webhook-hmac-key
ALM_SECRET_PREFIX=
ALM_AWS_REGION=
# Azure Key Vault (names use dashes): https://<vault>.vault.azure.net/
ALM_AZURE_KEY_VAULT_URL=
# In the cloud the Gemini key comes from this secret instead of GEMINI_API_KEY.
ALM_GEMINI_API_KEY_SECRET_NAME=alm-gemini-api-key
# Secret ids, not full resource names. Pin the version in PROD if rotation must
# be deliberate.
ALM_SECRET_VERSION=latest
# Directory Cloud Run mounts secret files into.
ALM_SECRET_DIR=/secrets

# --- Sign-in and roles (API and console) ---
# iap: a proxy in front signs people in (Google IAP). oidc: the service signs
# them in against the company IdP itself.
ALM_AUTH_MODE=iap
ALM_OIDC_ISSUER=
ALM_OIDC_CLIENT_ID=
# Both are secrets (environment, mounted file or the cloud store), by name:
ALM_OIDC_CLIENT_SECRET_NAME=alm-oidc-client-secret
ALM_SESSION_SECRET_NAME=alm-session-signing-key
ALM_OIDC_GROUPS_CLAIM=groups
# JSON: IdP group (or e-mail address, or "*") -> role. Roles: viewer, operator,
# approver, auditor, admin. Nobody without a role gets in.
ALM_ROLE_MAP={}

# --- Approvals ---
# Base URL of the console; announcements link to <base>/?run=<thread-id>.
ALM_APPROVAL_BASE_URL=
# IAP JWT audience (/projects/<number>/global/backendServices/<id>). When set, the
# caller is taken only from a verified IAP JWT, never from a plain header.
ALM_IAP_AUDIENCE=
ALM_APPROVAL_TTL_MINUTES=240
ALM_AUTO_APPROVE_LOW_RISK=false
# Two-person rule: production cards, and cards with a high-risk user, need two
# distinct approvers, neither the person who started the run.
ALM_APPROVERS_REQUIRED=1
ALM_APPROVERS_REQUIRED_PROD=2
ALM_APPROVERS_REQUIRED_HIGH_RISK=2
# Where cards are announced: any of chat, teams, email. None of them can approve.
ALM_NOTIFY_CHANNELS=chat
ALM_CHAT_WEBHOOK_URL=
ALM_TEAMS_WEBHOOK_URL=
ALM_SMTP_HOST=
ALM_SMTP_PORT=587
ALM_SMTP_FROM=
ALM_APPROVER_EMAILS=

# --- Observability ---
ALM_TRACE_ENABLED=true
ALM_LOG_LEVEL=INFO
# OpenTelemetry: each run as spans, and the service's metrics, over OTLP/HTTP.
# Any backend (an OpenTelemetry collector, ADOT, Azure Monitor, Honeycomb,
# Datadog). Prompts, replies, user IDs and error messages are never exported.
# Needs: pip install -r requirements-cloud.txt (or '.[otel]').
ALM_OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=<key>   # real value in .env only
ALM_OTEL_METRIC_INTERVAL_SECONDS=60
