# --- ALM Access Request retrieval (OSLC REST API) ---
# EWM/ccm base. Switch TEST/PROD by changing this one line.
#   TEST: https://prssetst.intra.chrysler.com/ccm
#   PROD: <set your production ccm base>
EWM_SERVER=https://prssetst.intra.chrysler.com/ccm
# Your Jazz/EWM username. Both agents use CID; EWM_USER remains a CLI-compatible alias.
CID=
# EWM_PASSWORD=   # optional; prefer the interactive prompt
# Use these to skip additional discovery and limit the agent to the required OSLC
# endpoints only.
EWM_PROJECT_UUID=
EWM_WORKFLOW_STATE_ID=
EWM_ACTIVE_STATE_IDS=

# --- GPT (Global Provisioning Tool) provisioning ---
GPT_URL=https://gpt.fiatspa.com/GlobalProvisioningTool/home.jsf
GROUP_NAME=GR_D-JazzUser-NA
AD_LABEL=inetpsa.com
DOMAIN=INETPSA
# Comma-separated user IDs to add. Leave empty and use --auto to pull from the open ELM tab.
USER_IDS=
# CDP endpoint of the debug Chrome started by start-gpt.ps1
CDP_URL=http://127.0.0.1:9222
# false = dry run (stage only). Use --commit to submit.
COMMIT=false

# --- JTS user import (Jazz Team Server user registry) ---
JTS_SERVER=https://prssetst.intra.chrysler.com/jts
# File written by the retrieval agent and read by the import agent.
ALM_USERS_OUT=out/alm_users.json

# --- Network ---
# requests/urllib do not evaluate the corporate PAC file, so intranet hosts would
# otherwise be tunnelled through the proxy and fail with 502 Bad Gateway.
NO_PROXY=.intra.chrysler.com,.chrysler.com,localhost,127.0.0.1

# --- Safety and environment ---
# Which environment these servers belong to. Leave blank to derive it from the
# host names (a "tst" host is TEST, otherwise PROD). Every entry point prints a
# banner with this value, and a PROD write must be confirmed by typing PROD.
ALM_ENV=
# Set to PROD to pre-authorise production writes for a non-interactive run.
# Leave unset for normal interactive use so the confirmation is actually asked.
# ALM_PROD_CONFIRM=

# --- TLS ---
# Path to the corporate CA bundle (.pem). When set, every request verifies the
# server certificate. Strongly recommended: without it credentials are POSTed
# over a connection that cannot detect interception.
ALM_CA_BUNDLE=
# Alternative to ALM_CA_BUNDLE when the corporate CA is already in the system
# trust store: true = verify, strict = refuse to run unverified, unset = do not
# verify (prints a warning on every run).
ALM_TLS_VERIFY=

# --- Work-item comment ---
# First line of the comment posted to each work item. The per-user lines are
# generated from what the import step actually did and are not configurable.
# ALM_COMMENT_HEADER=ALM access provisioning result :

# =============================================================================
# Multi-agent system, run locally: python src/agent_local.py
# Uses the CLI settings above unchanged (EWM_SERVER, JTS_SERVER, CID, the
# project/state ids, ALM_CA_BUNDLE / ALM_TLS_VERIFY, CDP_URL, GPT_URL, AD_LABEL,
# GROUP_NAME, DOMAIN). The password is prompted, as in the CLI. Add:
# =============================================================================
# GEMINI_API_KEY=...          (see "AI models" below; the key goes in .env only)
# Ledger, audit trail, approvals and resumable checkpoints, in one local file.
# Default out/local/alm.db. The CLI's out/audit/ is separate: do not run the CLI
# and the agents on the same work items.
ALM_LEDGER_PATH=
# Strip e-mail addresses from what Gemini reads (user IDs are kept). On the
# Gemini API free tier Google may use prompts to improve its products - use a
# paid key for real work items.
ALM_REDACT_FOR_MODEL=true
# Evidence screenshots of each user's JTS profile. Default: the installed
# Microsoft Edge on Windows (as the CLI), bundled Chromium elsewhere.
# ALM_BROWSER_CHANNEL=msedge
# true shows the browser while it captures - useful when a screenshot fails.
# ALM_BROWSER_HEADED=false

# =============================================================================
# Autonomous (Google Cloud) deployment only - optional, not needed locally. The CLI above needs none of this.
# Cloud Run injects most of it; these are here so a local run can be configured
# the same way.
# =============================================================================

# --- Project and region ---
GOOGLE_CLOUD_PROJECT=
ALM_REGION=europe-west1
# Vertex AI region if it must differ from ALM_REGION (vertex provider only).
ALM_VERTEX_LOCATION=

# --- Orchestration ---
# agentic  : an LLM supervisor routes nine tool-calling agents.
# deterministic : the fixed graph, same tools and guarantees, no routing model.
#                 Also the kill switch during an incident.
ALM_ORCHESTRATION=agentic
ALM_MAX_HOPS=24
ALM_MAX_WRITES_PER_RUN=50
ALM_MAX_TOOL_CALLS_PER_RUN=400

# --- AI models (Gemini) ---
# Where the model comes from:
#   gemini_api : the Gemini Developer API, with the key below. Quickest start;
#                what the local sandbox (python src/agent_sandbox.py) uses.
#   vertex_express : Vertex AI with an API key made in the Google Cloud console
#                (Vertex AI > API keys). Looks like an AI Studio key but only
#                works here - `--check` tells you which kind you have.
#   vertex     : the same models on Vertex AI, authenticated as the service
#                account - no key at all. The production choice. Needs
#                GOOGLE_CLOUD_PROJECT; also the only way to use claude-* models.
ALM_LLM_PROVIDER=gemini_api
# Your key from https://aistudio.google.com/apikey - paste it after the = sign.
# This file is .env.example (committed); put the real value in .env (gitignored).
# Never paste the key into code, a commit, or a chat.
GEMINI_API_KEY=
# In Cloud Run the key comes from this Secret Manager secret instead.
ALM_GEMINI_API_KEY_SECRET_NAME=alm-gemini-api-key
# Agents reason and call tools with ALM_AGENT_MODEL; the supervisor only routes,
# so a lighter model is enough. `python src/agent_sandbox.py --check` lists what
# your key can use.
ALM_AGENT_MODEL=gemini-3.5-flash
ALM_SUPERVISOR_MODEL=gemini-3.1-flash-lite
# Shared by every agent in the process. The free tier allows only a handful of
# requests per minute; a multi-agent run makes dozens.
ALM_LLM_REQUESTS_PER_MINUTE=10
# default | minimal | low | medium | high. Routing and tool calls need little.
ALM_LLM_THINKING_LEVEL=low
ALM_LLM_ENABLED=true

# --- User-ID recovery (optional: TypeSafe) ---
# When a New Users row cannot be parsed, code lists every token shaped like a
# user ID and a model judges which are people being requested. The answer is
# always a token copied from the row, never a generated one.
#   auto     : TypeSafe when the key below is set, Gemini otherwise
#   typesafe : TypeSafe only; if it fails, the row goes to a human
#   gemini   : the agent model judges (still limited to the listed tokens)
ALM_EXTRACTION_PROVIDER=auto
# From https://console.typesafe.ai/ - real value in .env only, never committed.
# Not reachable from Cloud Run as deployed: that network has no internet egress.
TYPESAFE_API_KEY=
ALM_TYPESAFE_MODEL=jev-latest
# Candidates below this probability are not proposed. A placeholder: tune it on
# real malformed rows. Recovered users always go to a human approver anyway.
ALM_EXTRACTION_MIN_PROBABILITY=0.5

# --- Shadow mode ---
# Read and plan, write nothing. Turning this off is the decision that lets an
# agent write; it belongs in a change record.
ALM_SHADOW_MODE=true

# --- Cloud SQL ---
# Private IP, reached over Direct VPC egress. With IAM database authentication
# the password is omitted - a short-lived access token is fetched at connect time.
ALM_POSTGRES_DSN=
ALM_POSTGRES_IAM_AUTH=true

# --- Pub/Sub (AD jobs for the Windows worker) ---
ALM_PUBSUB_TOPIC=alm-ad-provisioning
ALM_PUBSUB_SUBSCRIPTION=alm-ad-provisioning-worker

# --- Secret Manager ---
# Secret ids, not full resource names. Pin the version in PROD if rotation must
# be deliberate.
ALM_SECRET_VERSION=latest
# Directory Cloud Run mounts secret files into.
ALM_SECRET_DIR=/secrets

# --- Approval surface ---
ALM_APPROVAL_BASE_URL=
ALM_CHAT_WEBHOOK_URL=
ALM_APPROVAL_TTL_MINUTES=240
ALM_AUTO_APPROVE_LOW_RISK=false

# --- Observability ---
ALM_TRACE_ENABLED=true
ALM_LOG_LEVEL=INFO
